        </mxCell>
        <mxCell id="175" value="&lt;b&gt;Residual update + normalization&lt;/b&gt;&lt;br/&gt;Y = LayerNorm( Z + α · mean(Conv_d(Z)) )&#xa;residual scale α initialized to 0.05" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#8ab46f;strokeWidth=1.5;fillColor=#f7fff7;fontSize=16;align=center;verticalAlign=middle;spacing=6;" parent="2" vertex="1">
