        <mxCell id="139" value="Implementation-aligned notes: Base hidden dimension = 128; KeepT24 preserves encoded temporal length at 24; CAPT = Part Pyramid + ConfAware + PDTM; the final head uses global pooling over time and part tokens, followed by LayerNorm, Dropout, and FC classification." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontColor=#4b5563;fontStyle=0;" parent="2" vertex="1">
          <mxGeometry x="72" y="944" width="2028" height="34" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
