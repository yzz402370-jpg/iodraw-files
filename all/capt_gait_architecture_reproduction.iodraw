        <mxCell id="156" value="CAPT solves three code-aligned challenges: anatomical part dependency, heterogeneous keypoint reliability, and short-period temporal dynamics." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#6b7280;fontStyle=0;" parent="2" vertex="1">
