        <mxCell id="199" value="Figure Notes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#0f4c81;strokeWidth=2;fillColor=#0f4c81;fontColor=#ffffff;fontStyle=1;fontSize=20;align=center;verticalAlign=middle;" parent="2" vertex="1">
