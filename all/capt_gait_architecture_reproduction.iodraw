        <mxCell id="216" value="&lt;b&gt;Branch d = 4&lt;/b&gt;&lt;br/&gt;depthwise Conv1D(k=3)&#xa;→ pointwise Conv1D&#xa;→ BN + GELU + Dropout" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#8bb56f;strokeWidth=1.2;fillColor=#f6fff6;fontSize=14;align=center;verticalAlign=middle;spacing=5;" parent="2" vertex="1">
