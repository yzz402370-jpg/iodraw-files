        <mxCell id="173" value="&lt;b&gt;Branch d = 4&lt;/b&gt;&lt;br/&gt;depthwise Conv1D(k=3)&#xa;→ pointwise Conv1D&#xa;→ BN + GELU + Dropout" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#8ab46f;strokeWidth=1.5;fillColor=#f7fff7;fontSize=15;align=center;verticalAlign=middle;spacing=6;" parent="2" vertex="1">
