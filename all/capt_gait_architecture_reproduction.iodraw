        <mxCell id="192" value="&lt;b&gt;Feature branch&lt;/b&gt;&lt;br/&gt;score(h) → a&#xa;softmax feature attention" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#efb550;strokeWidth=1.2;fillColor=#fff7e7;fontSize=15;align=center;verticalAlign=middle;spacing=5;" parent="2" vertex="1">
          <mxGeometry x="834" y="372" width="198" height="84" as="geometry" />
        </mxCell>
        <mxCell id="193" value="&lt;b&gt;Confidence branch&lt;/b&gt;&lt;br/&gt;temporal smoothing kernel = 3&#xa; c = s_min + (1−s_min) s^ρ&#xa;ρ = 0.75,  s_min = 0.35" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#efb550;strokeWidth=1.2;fillColor=#fff7e7;fontSize=14;align=center;verticalAlign=middle;spacing=5;" parent="2" vertex="1">
          <mxGeometry x="1140" y="356" width="184" height="116" as="geometry" />
        </mxCell>
        <mxCell id="194" value="&lt;b&gt;Multiply-mode correction&lt;/b&gt;&lt;br/&gt;a_conf = normalize(a ⊙ c)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#efb550;strokeWidth=1.2;fillColor=#fff3d8;fontSize=16;align=center;verticalAlign=middle;spacing=5;" parent="2" vertex="1">
          <mxGeometry x="932" y="520" width="262" height="86" as="geometry" />
        </mxCell>
        <mxCell id="195" value="&lt;b&gt;Blended confidence-aware weights&lt;/b&gt;&lt;br/&gt;w = (1−λ)a + λa_conf&#xa;λ = 0.50" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#efb550;strokeWidth=1.2;fillColor=#fff7e7;fontSize=16;align=center;verticalAlign=middle;spacing=5;" parent="2" vertex="1">
          <mxGeometry x="932" y="644" width="262" height="86" as="geometry" />
        </mxCell>
        <mxCell id="196" value="&lt;b&gt;Output token correction&lt;/b&gt;&lt;br/&gt;apply at the fine joint-to-part level&#xa;soft correction instead of hard masking" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#efb550;strokeWidth=1.2;fillColor=#fff3d8;fontSize=15;align=center;verticalAlign=middle;spacing=5;" parent="2" vertex="1">
