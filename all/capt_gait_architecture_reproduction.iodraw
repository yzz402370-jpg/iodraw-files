        </mxCell>
        <mxCell id="200" value="• Part Pyramid produces 12 part tokens: 7 fine + 4 coarse + 1 global.  • ConfAware uses multiply-mode soft correction with a confidence floor, smoothing kernel 3, and fine-level application.&#xa;• PDTM combines KeepT24 and residual dilated temporal convolution (d = 1, 2, 4), then sends the refined token tensor to the global pooling + FC head.  • The diagram is aligned to the paper description and the final full-model training configuration." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=17;fontColor=#1f2937;fontStyle=0;" parent="2" vertex="1">
          <mxGeometry x="72" y="1075" width="2040" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
