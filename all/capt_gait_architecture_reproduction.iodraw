        <mxCell id="213" value="&lt;b&gt;Token-sequence organization&lt;/b&gt;&lt;br/&gt;for each part token, model temporal evolution along the 24-step sequence" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#8bb56f;strokeWidth=1.2;fillColor=#eef9ee;fontSize=15;align=center;verticalAlign=middle;spacing=5;" parent="2" vertex="1">
