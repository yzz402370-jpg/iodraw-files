        <mxCell id="139" value="&lt;b&gt;Fine part token pooling&lt;/b&gt;&lt;br/&gt;For each fine part k:  p_{t,k} = Σ α_{t,v}^{(k)} h_{t,v},   Σ α = 1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#4c78d0;strokeWidth=1.5;fillColor=#eef4ff;fontSize=16;align=center;verticalAlign=middle;spacing=6;" parent="2" vertex="1">
