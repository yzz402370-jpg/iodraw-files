        <mxCell id="174" value="&lt;b&gt;Joint-to-part learned pooling&lt;/b&gt;&lt;br/&gt;For each fine part k:  p_{t,k} = Σ α_{t,v}^{(k)} h_{t,v}&#xa;α is learned by feature-based attention over joints" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#4c78d0;strokeWidth=1.2;fillColor=#eef4ff;fontSize=15;align=center;verticalAlign=middle;spacing=5;" parent="2" vertex="1">
          <mxGeometry x="360" y="356" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="175" value="&lt;b&gt;Coarse tokens&lt;/b&gt;&lt;br/&gt;4 coarse tokens&#xa;head/neck&#xa;trunk+tail&#xa;forelimbs&#xa;hindlimbs" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#8fb1e6;strokeWidth=1.2;fillColor=#f5f9ff;fontSize=14;align=center;verticalAlign=middle;spacing=5;" parent="2" vertex="1">
          <mxGeometry x="360" y="488" width="128" height="96" as="geometry" />
        </mxCell>
        <mxCell id="176" value="&lt;b&gt;Global token&lt;/b&gt;&lt;br/&gt;1 global body token&#xa;from all fine tokens" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#8fb1e6;strokeWidth=1.2;fillColor=#f5f9ff;fontSize=14;align=center;verticalAlign=middle;spacing=5;" parent="2" vertex="1">
          <mxGeometry x="512" y="488" width="128" height="96" as="geometry" />
        </mxCell>
        <mxCell id="177" value="&lt;b&gt;Concatenate &amp; embed&lt;/b&gt;&lt;br/&gt;Concatenate 7 fine + 4 coarse + 1 global token&#xa;then add learnable token embeddings" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#4c78d0;strokeWidth=1.2;fillColor=#eef4ff;fontSize=15;align=center;verticalAlign=middle;spacing=5;" parent="2" vertex="1">
